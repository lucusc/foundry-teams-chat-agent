# Copy to .env.dev and replace placeholders before provisioning.
# Keep real deployment settings and secrets out of source control.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Choose a unique suffix (bot + suffix must be 4-20 lowercase letters/digits).
# Keep the suffix stable after provisioning.
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP_NAME=rg-foundry-teams-app-dev
RESOURCE_SUFFIX=<unique-suffix>

SHAREPOINT_TENANT_DOMAIN=<tenant-prefix>

# Existing Microsoft Foundry project and model deployment
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>
GRAPH_HISTORY_MESSAGE_COUNT=10

# Generated by provisioning; leave blank for a new deployment.
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
BOT_AZURE_APP_SERVICE_RESOURCE_ID=
BOT_DOMAIN=
BOT_ID=
BOT_TENANT_ID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
SSO_APP_ID=
SSO_APP_ID_URI=
